{
  "name": "tavern",
  "version": "0.0.1",
  "private": true,
  "description": "D&D-flavored CYOA game engine — Telegram bot on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:telegram": "wrangler dev --local-protocol=https",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "srd:seed": "tsx scripts/seed-srd.ts",
    "db:migrate": "wrangler d1 migrations apply tavern-db --local",
    "typecheck": "tsc --noEmit",
    "play": "tsx src/cli/play.ts",
    "dev:ui": "tsx src/devui/server.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.11.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.50.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "ws": "^8.21.0"
  }
}
